# Same-origin API path — Vite dev server proxies to VITE_PROXY_TARGET (no CORS).
VITE_API_URL=/api/v1
# Production UnikTrades API (emails need RESEND_API_KEY on uniktrades-api in Render):
# VITE_PROXY_TARGET=https://uniktrades-api.onrender.com

# Local UnikTrades backend (PORT=4001 in backend/.env — 4000 is often another project):
VITE_PROXY_TARGET=http://localhost:4001
